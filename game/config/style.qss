QWidget {
    background-color: #121212; /* Ciemne tło dla całej aplikacji */
    color: #ffffff;            /* Biały tekst */
}
QLabel{
    padding: 10px;
    border-radius: 10px;
    background-color: transparent;
    font-size: 24px;
}
QPushButton {
    background-color: #1e1e1e;
    border: 2px solid #3a3a3a;
    border-radius: 5px;
    padding: 10px;
    font-size: 16px;
    min-width: 150px;
    max-width: 250px;
    
}
QPushButton:hover {
    background-color: #2c2c2c;
    border-color: #4a4a4a;

}
QSlider{
    background-color: transparent;
}
/* Specyficzny styl dla przycisku Start za pomocą ID */
#start_button {
    background-color: #27ae60;
    border-color: #2ecc71;
}
#start_button:hover {
    background-color: #2ecc71;
    border-color: #27ae60;
}
#exit_button {
    background-color: #c0392b;
    border-color: #e74c3c;
}
#back_to_menu_btn
{
    max-width: 150px;
    background-color: #1e1e1e;
    border-color: #3a3a3a;
}
#exit_button:hover {
    background-color: #e74c3c;
    border-color: #c0392b;
}
#back_to_menu_btn:hover
{
    background-color:#4a4a4a;
    border-color: #3a3a3a;
}
/* SetUpPanel */
#setuppanel {
    background-color: #2c2c2c; /* Ciemniejszy szary dla kontrastu */
    opacity: 50%;
    color: #ffffff;
    border: 2px solid #3a3a3a; /* Estetyczna ramka */
    border-radius: 10px;       /* Łagodne, zaokrąglone rogi */
}
#setup_tittle_label
{
    padding: 10px;
    border-radius: 10px;
    background-color: #27ae60;
}
#menu_bar{
    background-color: #333; color: white;
    max-height: 100px;
}
#game_dashboard{
background-color: beige;
color: #121212;
}
#settings_panel{
    background-color: #333;
    max-height: 400px;
    max-width: 500px;
    min-width: 300px;
}
#sound_val_label {
    padding: 0px;        /* Likwiduje ucinanie tekstu */
    font-size: 18px;     /* Opcjonalnie: nieco mniejsza czcionka wygląda zgrabniej obok suwaka */
}